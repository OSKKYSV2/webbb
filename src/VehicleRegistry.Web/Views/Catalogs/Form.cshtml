@model VehicleRegistry.Web.Models.Catalogs.CatalogForm
@{
    bool edit = Model.Id != 0;
    ViewData["Title"] = edit ? "Upravit záznam" : "Nový záznam";
}
<div class="page-heading"><div><span class="eyebrow">ČÍSELNÍKY</span><h1>@ViewData["Title"]</h1></div></div>
<div class="form-panel">
    <form asp-action="@(edit ? "Edit" : "Create")" asp-route-id="@(edit ? Model.Id : null)" method="post">
        <input asp-for="Id" type="hidden"/><input asp-for="Kind" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div>
        @if (Model.Kind == "manufacturers")
        {
            <div class="mb-3"><label asp-for="Country" class="form-label"></label><input asp-for="Country" class="form-control"/><span asp-validation-for="Country" class="text-danger"></span></div>
        }
        else if (Model.Kind == "types")
        {
            <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
            <div class="row g-3"><div class="col-md-6"><label asp-for="RecommendedIntervalKm" class="form-label"></label><input asp-for="RecommendedIntervalKm" class="form-control"/><span asp-validation-for="RecommendedIntervalKm" class="text-danger"></span></div><div class="col-md-6"><label asp-for="RecommendedIntervalMonths" class="form-label"></label><input asp-for="RecommendedIntervalMonths" class="form-control"/><span asp-validation-for="RecommendedIntervalMonths" class="text-danger"></span></div></div>
        }
        else if (Model.Kind == "centers")
        {
            <div class="mb-3"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control"/><span asp-validation-for="Address" class="text-danger"></span></div>
            <div class="row g-3"><div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control"/></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email" class="text-danger"></span></div></div>
        }
        <div class="d-flex gap-2 mt-4"><button type="submit" class="btn btn-primary">Uložit</button><a asp-action="Index" asp-route-kind="@Model.Kind" class="btn btn-outline-secondary">Zrušit</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
